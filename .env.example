# Copy this file to .env and replace placeholder values. Never commit .env.

# Application
APP_NAME=AI Henge Fund
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# AI providers
# OpenAI is preferred when both providers are configured.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4.1

# Gemini is used automatically when OpenAI is unavailable or hits a
# quota/rate-limit/authentication-style provider failure.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_DEEP_THINK_LLM=gemini-2.5-pro
GEMINI_QUICK_THINK_LLM=gemini-2.5-flash

# Neon PostgreSQL
DATABASE_URL=postgresql+psycopg://username:password@host/database?sslmode=require

# TradingAgents
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=gpt-4.1
TRADINGAGENTS_QUICK_THINK_LLM=gpt-4.1-mini
TRADINGAGENTS_BACKEND_URL=https://replace-with-tradingagents-backend-url

# Moomoo local OpenD market data (read-only)
# The OpenD endpoint has already been validated locally at 127.0.0.1:11111.
MOOMOO_OPEND_ENABLED=false
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_READ_ONLY=true
MOOMOO_VERIFY_SYMBOL=AAPL

# Optional Streamable HTTP MCP transport. Keep disabled until its endpoint and
# credentials are independently verified. Never add trading/order tools here.
MOOMOO_MCP_ENABLED=false
MOOMOO_MCP_URL=http://127.0.0.1:8000
MOOMOO_MCP_ACCESS_TOKEN=replace-with-readonly-mcp-token

# Streamlit
STREAMLIT_SERVER_PORT=8501
