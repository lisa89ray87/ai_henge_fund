# Copy this file to .env and replace placeholder values. Never commit .env.

# Application
APP_NAME=AI Henge Fund
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4.1

# Neon PostgreSQL
DATABASE_URL=postgresql+psycopg://username:password@host/database?sslmode=require

# TradingAgents
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=gpt-4.1
TRADINGAGENTS_QUICK_THINK_LLM=gpt-4.1-mini
TRADINGAGENTS_BACKEND_URL=https://replace-with-tradingagents-backend-url

# Moomoo MCP (Stages 1 and 2: disabled and read-only only)
MOOMOO_MCP_ENABLED=false
MOOMOO_MCP_URL=http://127.0.0.1:8000
MOOMOO_READ_ONLY=true
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# Streamlit
STREAMLIT_SERVER_PORT=8501
